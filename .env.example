# PostgreSQL
POSTGRES_USER=husker
POSTGRES_PASSWORD=husker
POSTGRES_DB=husker_mini
POSTGRES_PORT=5432
DATABASE_URL=postgresql://husker:husker@localhost:5432/husker_mini

# Kalshi
KALSHI_API_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_API_KEY_ID=
KALSHI_API_PRIVATE_KEY=

# Sports provider
SPORTS_PROVIDER=espn
SPORTS_PROVIDER_API_BASE_URL=https://site.api.espn.com/apis/site/v2/sports
SPORTS_PROVIDER_API_KEY=

# News provider
NEWS_PROVIDER_API_BASE_URL=https://newsapi.org/v2
NEWS_PROVIDER_API_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_COMBINER_MODEL=gpt-5

# Prediction parameters
PREDICTION_TECHNICAL_K=1
PREDICTION_TECHNICAL_WEIGHT=0.5
PREDICTION_EDGE_THRESHOLD=0.02
PREDICTION_KELLY_FRACTION=0.15
PREDICTION_STARTING_BANKROLL_CENTS=0
PREDICTION_MIN_CONTRACTS=1
PREDICTION_MAX_CONTRACTS=1000

# Live trading (default off — pipeline paper-trades until explicitly enabled)
LIVE_TRADING_ENABLED=false

# Worker configuration
PREDICTION_WORKER_POLL_INTERVAL_MS=5000
SETTLEMENT_WORKER_POLL_INTERVAL_MS=60000
