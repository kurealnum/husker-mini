{
  "name": "husker-mini",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,prediction,settlement -c blue,green,yellow \"next dev\" \"npm:worker:prediction\" \"npm:worker:settlement\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:verify": "tsx scripts/verify-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx -r dotenv/config scripts/migrate.ts",
    "worker:prediction": "tsx watch -r dotenv/config src/workers/prediction-worker.ts",
    "worker:settlement": "tsx watch -r dotenv/config src/workers/settlement-worker.ts",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run integration"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "openai": "^6.49.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.4",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
