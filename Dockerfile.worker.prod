# Production image for the prediction/settlement background workers.
# Which worker to run is selected at container start via the WORKER_SCRIPT
# environment variable (see docker-compose.prod.yml) — unlike the dev image,
# this runs the script once via tsx with no watch/reload.
FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN chown -R node:node /app

USER node

CMD ["sh", "-c", "npx tsx \"$WORKER_SCRIPT\""]
